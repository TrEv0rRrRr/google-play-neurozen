---
import gPlayButton from "../../images/logos/gplay.png";
---

<div
  id="scroll-sentinel"
  class="absolute top-12 left-0 w-full h-px pointer-events-none"
>
</div>

<header
  id="main-header"
  class="flex flex-col gap-7 fixed top-0 z-1 bg-white w-full self-start py-4 px-10 h-16"
>
  <div class="flex items-center justify-between">
    <div class="flex gap-5 items-center">
      <img src={gPlayButton.src} alt="Google Play Logo" class="w-38" />

      <nav class="flex">
        <ul
          class="flex items-center justify-between gap-10 pl-2 text-[14px] font-medium text-secondary"
        >
          <li>Juegos</li>
          <li
            class="text-accent after:content-[''] after:w-full after:h-[0.21rem] after:bg-accent after:top-10 after:left-0 relative after:absolute"
          >
            Apps
          </li>
          <li>Libros</li>
          <li>Infantiles</li>
        </ul>
      </nav>
    </div>
    <div class="flex items-center justify-between gap-5">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-6"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
        ></path>
      </svg>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-6"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z"
        ></path>
      </svg>
      <div
        class="w-8 h-8 rounded-full bg-green-800 text-white flex items-center justify-center text-[18px]"
      >
        C
      </div>
    </div>
  </div>
</header>

<script>
  const sentinel = document.getElementById("scroll-sentinel");
  const header = document.getElementById("main-header");

  const shadowClasses = ["shadow-lg", "shadow-black/20", "transition-all"];

  if (sentinel && header) {
    const observer = new IntersectionObserver(([entry]) => {
      // Si el centinela deja de verse (se pasó la altura), aplicamos la sombra
      if (!entry.isIntersecting) {
        header.classList.add(...shadowClasses);
      } else {
        header.classList.remove(...shadowClasses);
      }
    });

    observer.observe(sentinel);
  }
</script>
