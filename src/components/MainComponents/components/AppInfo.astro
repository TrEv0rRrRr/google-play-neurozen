---
import ESRBLogo from "../../../images/logos/esrb.png";
import Apps from "../../../images/apps.png";
import Button from "../ui/Button.astro";
import SecondaryTitle from "../ui/SecondaryTitle.astro";
import Span from "../ui/Span.astro";
import About from "./About.astro";
import Comments from "./Comments.astro";
---

<section class="flex gap-15 justify-between">
  <div class="flex flex-col gap-8 w-218">
    <div class="flex flex-col gap-8">
      <div class="flex flex-col gap-5">
        <SecondaryTitle>Novedades</SecondaryTitle>
        <Span style="second"
          >- Se corrigieron algunos errores y se mejoró la estabilidad.</Span
        >
      </div>

      <div class="flex flex-col gap-2">
        <SecondaryTitle>
          <div class="flex items-center gap-3">
            Seguridad de los datos
            <span
              class="p-2 cursor-pointer hover:bg-[#f5f5f5] transition-colors hover:rounded-2xl"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
              </svg>
            </span>
          </div>
        </SecondaryTitle>

        <Span style="second">
          El primer paso de la seguridad es comprender cómo los desarrolladores
          recopilan y comparten tus datos. Las prácticas de privacidad y
          seguridad de datos pueden variar en función del uso de la app, la
          región y la edad. El desarrollador proporcionó esta información y
          podría actualizarla con el tiempo.
        </Span>

        <div
          class="flex flex-col border border-[#c4c7c5] rounded-md px-6 py-4 gap-6 font-[.875rem] my-6 items-start"
        >
          <ul class="flex flex-col gap-5">
            <li class="flex gap-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M7.217 10.907a2.25 2.25 0 1 0 0 2.186m0-2.186c.18.324.283.696.283 1.093s-.103.77-.283 1.093m0-2.186 9.566-5.314m-9.566 7.5 9.566 5.314m0 0a2.25 2.25 0 1 0 3.935 2.186 2.25 2.25 0 0 0-3.935-2.186Zm0-12.814a2.25 2.25 0 1 0 3.933-2.185 2.25 2.25 0 0 0-3.933 2.185Z"
                ></path>
              </svg>
              <div class="flex flex-col">
                <Span style="second">No se comparten datos con terceros</Span>
                <Span style="second">
                  <span class="underline cursor-pointer">Más información</span> sobre
                  cómo los desarrolladores declaran el uso compartido
                </Span>
              </div>
            </li>
            <li class="flex gap-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 16.5V9.75m0 0 3 3m-3-3-3 3M6.75 19.5a4.5 4.5 0 0 1-1.41-8.775 5.25 5.25 0 0 1 10.233-2.33 3 3 0 0 1 3.758 3.848A3.752 3.752 0 0 1 18 19.5H6.75Z"
                ></path>
              </svg>
              <div class="flex flex-col">
                <Span style="second">
                  Es posible que esta app recopile estos tipos de datos
                </Span>
                <Span style="second">
                  Información personal, Fotos y videos y 2 más
                </Span>
              </div>
            </li>
            <li class="flex gap-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z"
                ></path>
              </svg>
              <Span style="second">
                Los datos están encriptados en tránsito
              </Span>
            </li>
            <li class="flex gap-4">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"
                ></path>
              </svg>

              <Span style="second">
                Puedes solicitar que se borren los datos
              </Span>
            </li>
          </ul>
          <button
            class="text-accent text-[.875rem] font-medium ml-2 cursor-pointer hover:bg-green-50 transition-colors py-[0.4rem] rounded-[0.4rem] px-1"
            >Ver detalles</button
          >
        </div>
      </div>

      <div class="flex flex-col gap-4 mb-6">
        <div>
          <SecondaryTitle>Califica esta app</SecondaryTitle>
          <Span style="second">Comparte tu opinión con otros usuarios.</Span>
        </div>

        <div class="flex gap-4 mb-3">
          <Button selected>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"
              ></path>
            </svg>

            <span class="font-medium text-[14px]">Teléfono</span>
          </Button>
          <Button>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10.5 19.5h3m-6.75 2.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-15a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 4.5v15a2.25 2.25 0 0 0 2.25 2.25Z"
              ></path>
            </svg>

            <span class="font-medium text-[14px]">Tablet</span>
          </Button>
        </div>

        <button
          type="button"
          class="bg-accent w-max px-5 text-white font-black rounded-[0.4rem] text-[14px] cursor-pointer hover:bg-green-900 transition-colors py-[0.6rem]"
          >Escribe una opinión</button
        >
      </div>

      <Comments />
    </div>

    <About />
  </div>

  <div class="flex flex-col gap-8">
    <div
      class="flex border border-[#c4c7c5] rounded-2xl px-6 py-4 gap-4 font-[.875rem] mb-1"
    >
      <img src={ESRBLogo.src} alt="ESRB" class="h-9.5 w-auto min-w-9.5" />
      <div class="flex flex-col leading-5 gap-2">
        <p class="text-primary text-[1.375rem] leading-7">
          Apto para todo público
        </p>
        <p class="text-[#0b57d0] text-[14px] cursor-pointer">Más información</p>
      </div>
    </div>

    <div>
      <details class="group [&_summary::-webkit-details-marker]:hidden">
        <summary class="flex items-center justify-between cursor-pointer">
          <SecondaryTitle>Asistencia de la App</SecondaryTitle>
          <span
            class="transition-all duration-200 group-open:rotate-180 p-2 cursor-pointer hover:bg-[#f5f5f5] hover:rounded-2xl"
            ><svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3"></path>
            </svg>
          </span>
        </summary>

        <div class="grid grid-rows-3 mt-1">
          <div
            class="flex p-2 items-center cursor-pointer hover:bg-[#f5f5f5] transition-colors hover:rounded-2xl"
          >
            <a
              class="flex gap-4"
              href="https://quakexit-landing.netlify.app/"
              target="_blank"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-6"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418"
                ></path>
              </svg>
              <Span style="first">Sitio web</Span>
            </a>
          </div>

          <div
            class="flex p-2 cursor-pointer hover:bg-[#f5f5f5] transition-colors hover:rounded-2xl"
          >
            <a
              class="flex gap-4"
              href="mailto:help@quakexit.com"
              target="_blank"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="size-6"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"
                ></path>
              </svg>

              <div class="flex flex-col gap-1">
                <Span style="first">Correo de ayuda</Span>
                <Span style="second">help@quakexit.com</Span>
              </div>
            </a>
          </div>

          <div
            class="flex gap-4 items-center p-2 cursor-pointer hover:bg-[#f5f5f5] transition-colors hover:rounded-2xl"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-6"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z"
              ></path>
            </svg>
            <Span style="first">Política de privacidad</Span>
          </div>

          <div class="flex flex-col p-2 gap-2">
            <Span style="first">Acerca del desarrollador</Span>
            <ul>
              <li>
                <Span style="second">TerraGuard</Span>
              </li>
              <li>
                <Span style="second">help@quakexit.com</Span>
              </li>
              <li>
                <Span style="second">Av. República de Panamá 3545</Span>
              </li>
              <li>
                <Span style="second">San Isidro, Lima 15047</Span>
              </li>
              <li>
                <Span style="second">Perú</Span>
              </li>
            </ul>
          </div>
        </div>
      </details>
    </div>

    <div class="flex flex-col">
      <SecondaryTitle>
        <div class="flex items-center justify-between">
          Más apps para probar
          <span
            class="p-2 cursor-pointer hover:bg-[#f5f5f5] transition-colors hover:rounded-2xl"
          >
            <svg
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="1.5"
              stroke="currentColor"
              class="size-5"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
            </svg>
          </span>
        </div>
      </SecondaryTitle>

      <img src={Apps.src} alt="Apps para probar" class="mt-4" />
    </div>
  </div>
</section>
