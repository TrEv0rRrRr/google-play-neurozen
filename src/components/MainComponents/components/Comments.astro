---
import Button from "../ui/Button.astro";
import SecondaryTitle from "../ui/SecondaryTitle.astro";
import Span from "../ui/Span.astro";
import Stars from "../../../images/icons/stars.png";
import OpinionMetric from "../ui/OpinionMetric.astro";
import { comments } from "../../../common/comments";
import Comment from "./Comment.astro";
---

<div class="flex flex-col gap-5">
  <div class="flex justify-between items-center">
    <SecondaryTitle>
      <div class="flex items-center gap-3">
        Calificaciones y opiniones
        <span
          class="p-2 cursor-pointer hover:bg-[#f5f5f5] transition-colors hover:rounded-2xl"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="size-5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"></path>
          </svg>
        </span>
      </div>
    </SecondaryTitle>

    <Span style="second">
      <div
        class="flex gap-2 items-center cursor-pointer hover:bg-[#f5f5f5] transition-colors py-[0.4rem] rounded-[0.4rem] px-1"
      >
        Las calificaciones y opiniones están verificadas
        <span
          ><svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="size-5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m11.25 11.25.041-.02a.75.75 0 0 1 1.063.852l-.708 2.836a.75.75 0 0 0 1.063.853l.041-.021M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9-3.75h.008v.008H12V8.25Z"
            ></path>
          </svg></span
        >
      </div>
    </Span>
  </div>

  <div class="flex gap-4">
    <Button selected>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"
        ></path>
      </svg>

      <span class="font-medium text-[14px]">Teléfono</span>
    </Button>
    <Button>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M10.5 19.5h3m-6.75 2.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-15a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 4.5v15a2.25 2.25 0 0 0 2.25 2.25Z"
        ></path>
      </svg>

      <span class="font-medium text-[14px]">Tablet</span>
    </Button>
  </div>

  <div class="flex flex-col gap-10">
    <div class="flex gap-10">
      <div class="flex flex-col gap-2">
        <div>
          <Span style="third">4.8</Span>
          <img src={Stars.src} alt="" aria-hidden />
        </div>
        <Span style="fourth">5K opiniones</Span>
      </div>

      <ul class="w-full">
        <li class="flex gap-2 items-center">
          <Span style="fourth">5</Span>
          <OpinionMetric>
            <div class=`w-[80%] h-3 bg-accent rounded-xl`></div>
          </OpinionMetric>
        </li>
        <li class="flex gap-2 items-center">
          <Span style="fourth">4</Span>
          <OpinionMetric>
            <div class=`w-[20%] h-3 bg-accent rounded-xl`></div>
          </OpinionMetric>
        </li>
        <li class="flex gap-2 items-center">
          <Span style="fourth">3</Span>
          <OpinionMetric>
            <div class=`w-[10%] h-3 bg-accent rounded-xl`></div>
          </OpinionMetric>
        </li>
        <li class="flex gap-2 items-center">
          <Span style="fourth">2</Span>
          <OpinionMetric>
            <div class=`w-[0%] h-3 bg-accent rounded-xl`></div>
          </OpinionMetric>
        </li>
        <li class="flex gap-2 items-center">
          <Span style="fourth">1</Span>
          <OpinionMetric>
            <div class=`w-[5%] h-3 bg-accent rounded-xl`></div>
          </OpinionMetric>
        </li>
      </ul>
    </div>

    <section class="flex flex-col gap-8">
      {comments.map((comment) => <Comment comment={comment} />)}
    </section>
  </div>

  <button
    class="text-accent text-[.875rem] font-medium ml-2 cursor-pointer hover:bg-green-50 transition-colors py-[0.4rem] rounded-[0.4rem]
    px-3 mt-2 text-start w-max"
  >
    Ver todas las opiniones
  </button>
</div>
