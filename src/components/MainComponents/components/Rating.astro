---
import Button from "../ui/Button.astro";
import SecondaryTitle from "../ui/SecondaryTitle.astro";
import Span from "../ui/Span.astro";
import Comments from "./Comments.astro";
---

<div class="flex flex-col gap-4 mb-6">
  <div>
    <SecondaryTitle>Califica esta app</SecondaryTitle>
    <Span style="second">Comparte tu opinión con otros usuarios.</Span>
  </div>

  <div class="flex gap-4 mb-3">
    <Button selected>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M10.5 1.5H8.25A2.25 2.25 0 0 0 6 3.75v16.5a2.25 2.25 0 0 0 2.25 2.25h7.5A2.25 2.25 0 0 0 18 20.25V3.75a2.25 2.25 0 0 0-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 18.75h3"
        ></path>
      </svg>

      <span class="font-medium text-[14px]">Teléfono</span>
    </Button>
    <Button>
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="1.5"
        stroke="currentColor"
        class="size-5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M10.5 19.5h3m-6.75 2.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-15a2.25 2.25 0 0 0-2.25-2.25H6.75A2.25 2.25 0 0 0 4.5 4.5v15a2.25 2.25 0 0 0 2.25 2.25Z"
        ></path>
      </svg>

      <span class="font-medium text-[14px]">Tablet</span>
    </Button>
  </div>

  <button
    type="button"
    class="bg-accent w-max px-5 text-white font-black rounded-[0.4rem] text-[14px] cursor-pointer hover:bg-green-900 transition-colors py-[0.6rem]"
    >Escribe una opinión</button
  >
</div>

<Comments />
