---
interface Props {
  selected?: boolean;
}

const { selected } = Astro.props;
---

<button
  class="flex gap-2 border border-[#c4c7c5] rounded-2xl px-4 py-2 cursor-pointer"
  class:list={[
    "flex gap-2 border  rounded-2xl px-4 py-2 cursor-pointer",
    {
      "bg-accent/10 text-accent border-transparent hover:bg-[#647771]/15":
        selected,
    },
    { "border-[#c4c7c5] hover:bg-[#f5f5f5]": !selected },
  ]}
>
  <slot />
</button>
