---
import Span from "../MainComponents/ui/Span.astro";
---

<footer
  class="flex flex-col border border-t-[#E8EAED] border-b-0 border-r-0 border-l-0 pt-8 pb-8 mt-15 gap-10"
>
  <div class="flex gap-38">
    <ul class="flex flex-col gap-2">
      <li><Span style="first">Google Play</Span></li>
      <li><Span style="second">Play Pass</Span></li>
      <li><Span style="second">Play Points</Span></li>
      <li><Span style="second">Tarjetas de regalo</Span></li>
      <li><Span style="second">Canjear</Span></li>
      <li><Span style="second">Política de reembolsos</Span></li>
    </ul>
    <ul class="flex flex-col gap-2">
      <li><Span style="first">Niños y familia</Span></li>
      <li><Span style="second">Guía para padres</Span></li>
      <li><Span style="second">Uso compartido con la familia</Span></li>
    </ul>
  </div>

  <ul class="flex justify-between w-full">
    <div class="flex gap-6">
      <li><Span style="fourth">Términos y condiciones</Span></li>
      <li><Span style="fourth">Privacidad</Span></li>
      <li><Span style="fourth">Acerca de Google Play</Span></li>
      <li><Span style="fourth">Desarrolladores</Span></li>
      <li><Span style="fourth">Google Store</Span></li>
      <li><Span style="fourth">Todos los precios incluyen IVA</Span></li>
    </div>

    <li><Span style="fourth">Perú (Español (Perú))</Span></li>
  </ul>
</footer>
